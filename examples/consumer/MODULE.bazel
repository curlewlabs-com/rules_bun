module(name = "rules_bun_consumer")

bazel_dep(name = "curlewlabs_rules_bun", version = "0.11.4")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")

# renovate: datasource=node-version depName=node
node.toolchain(node_version = "24.22.3")
use_repo(node, "nodejs_darwin_amd64", "nodejs_darwin_arm64", "nodejs_linux_amd64", "nodejs_linux_arm64")

acquire = use_extension("//:deps.bzl", "deps")
use_repo(acquire, "consumer_bun", "npm")

# Pin the reviewed release bytes until the module is available through BCR.
archive_override(
    module_name = "curlewlabs_rules_bun",
    integrity = "sha256-0G+rvkzdbNG0dAssVgzwcFjykHfo6aEaW9p3PH2iL8Y=",
    strip_prefix = "rules_bun-0.11.4",
    type = "tar.gz",
    urls = ["https://github.com/curlewlabs-com/rules_bun/releases/download/v0.11.4/rules_bun-0.11.4.tar.gz"],
)

# rules_bun's npm rules depend on rules_archive_store, which is not in the BCR
# either, and an override binds only the root module (docs/npm.md sec."Setup").
archive_override(
    module_name = "curlewlabs_rules_archive_store",
    integrity = "sha256-b4s2vanHbhaJXwTiiZ3Zc7W66+XckLqCX7o9ReG908U=",
    strip_prefix = "rules_archive_store-0.6.0",
    urls = ["https://github.com/curlewlabs-com/rules_archive_store/releases/download/v0.6.0/rules_archive_store-0.6.0.tar.gz"],
)
