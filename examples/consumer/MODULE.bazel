module(name = "rules_bun_consumer")

bazel_dep(name = "curlewlabs_rules_bun", version = "0.9.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.21.0")
use_repo(node, "nodejs_darwin_amd64", "nodejs_darwin_arm64", "nodejs_linux_amd64", "nodejs_linux_arm64")

acquire = use_extension("//:deps.bzl", "deps")
use_repo(acquire, "consumer_bun", "npm")

# Pin the reviewed release bytes until the module is available through BCR.
archive_override(
    module_name = "curlewlabs_rules_bun",
    integrity = "sha256-erSIXLon/QO75SxtC9ts7JV2rVeZrz+HJVQ6iyGuE1E=",
    strip_prefix = "rules_bun-0.9.0",
    type = "tar.gz",
    urls = ["https://github.com/curlewlabs-com/rules_bun/releases/download/v0.9.0/rules_bun-0.9.0.tar.gz"],
)

# rules_bun's npm rules depend on rules_archive_store, which is not in the BCR
# either, and an override binds only the root module (docs/npm.md sec."Setup").
archive_override(
    module_name = "curlewlabs_rules_archive_store",
    integrity = "sha256-/DFoKgXonK3xqkqODoiIdoGsLXVoF1q20/g2vfo3czc=",
    strip_prefix = "rules_archive_store-0.1.0",
    urls = ["https://github.com/curlewlabs-com/rules_archive_store/releases/download/v0.1.0/rules_archive_store-0.1.0.tar.gz"],
)
